rules_version = '2';
// 썬빗(SUNBIT) Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 그대로 붙여넣고 게시하세요.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function shortText(t) { return t is string && t.size() > 0 && t.size() <= 140; }

    // 각자의 지갑: 로그인한 사람은 모두 읽고(순위 계산), 쓰기는 본인 문서만
    match /players/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 10;
      allow delete: if false;
    }

    // 매매·엿보기·게임 소식: 본인 이름으로만 추가, 수정·삭제 불가
    match /feed/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // 부동산: 게임에 있는 동작(매입·매도·파괴·복구·강제 매입)만 허용해요.
    // 남의 멀쩡한 건물 주인을 바꾸거나, 남의 건물을 파괴 말고 다른 식으로 고칠 수 없어요.
    match /estates/{id} {
      function me() { return request.auth.uid; }
      function oldOwner() { return resource.data.get('owner', null); }
      function oldBroken() { return resource.data.get('destroyed', null) != null; }
      function newOwner() { return request.resource.data.get('owner', null); }
      function newBroken() { return request.resource.data.get('destroyed', null); }
      allow read: if signedIn();
      // 빈 땅 첫 매입
      allow create: if signedIn() && request.resource.data.season is string
        && newOwner() == me() && newBroken() == null;
      allow update: if signedIn() && request.resource.data.season is string && (
        // 내가 주인이 되는 경우: 빈 건물 매입, 파괴된 건물 120% 매입, 남의 건물 강제 매입(200%) → 멀쩡한 상태
        (newOwner() == me() && newBroken() == null)
        // 내 건물: 매도(주인 비움) 또는 복구
        || (oldOwner() == me() && (newOwner() == null || newOwner() == me()) && newBroken() == null)
        // 남의 멀쩡한 건물 파괴: 주인·산 가격은 그대로, 파괴한 사람은 나
        || (oldOwner() != null && oldOwner() != me() && !oldBroken()
            && newOwner() == oldOwner()
            && request.resource.data.get('paid', 0) == resource.data.get('paid', 0)
            && newBroken() is map && newBroken().by == me())
      );
      allow delete: if false;
    }

    // ───── 썬빗(SUNBIT) 새 게임: sb_ 컬렉션. 예전 곰스피 컬렉션은 그대로 두고 따로 써요 ─────
    match /sb_players/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 10;
      allow delete: if false;
    }
    match /sb_feed/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // ───── 2026-11-12 리셋: sb2_ 컬렉션에서 새로 시작 (예전 sb_players·sb_feed는 그대로 보관) ─────
    match /sb2_players/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 10;
      allow delete: if false;
    }
    match /sb2_feed/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /sb_talk/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && shortText(request.resource.data.text);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if isOwner(resource.data.uid);
    }

    // 종목 채팅: 본인 이름으로만 보내고, 삭제는 본인 메시지만.
    // 수정은 좋아요(likes) 필드만 바꿀 수 있어요.
    match /talk/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && shortText(request.resource.data.text);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if isOwner(resource.data.uid);
    }
  }
}
